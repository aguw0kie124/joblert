# Copy to .env and fill in. Only DATABASE_URL is needed for step 1.
DATABASE_URL=postgres://tracker:tracker@localhost:5432/tracker
PORT=3000

# Needed from step 3 (classifier)
ANTHROPIC_API_KEY=

# Needed from step 4 (Gmail + sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# Needed only if the poller is triggered over HTTP
CRON_SECRET=
