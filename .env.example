# Copy to .env and fill in.
DATABASE_URL=postgresql://user:password@host:5432/database
PORT=3000

# Required: every email is read by Groq.
GROQ_API_KEY=

# OAuth client from Google Cloud. Redirect URI: <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Each at least 32 characters: openssl rand -base64 32
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# Gmail push (optional; set both or neither). Without them inboxes sync hourly and from the dashboard.
# Full topic name: projects/<project>/topics/<topic>. Setup steps are in server/API.md.
GMAIL_PUBSUB_TOPIC=
# At least 32 characters: openssl rand -hex 24. Goes in the subscription URL: <PUBLIC_URL>/webhooks/gmail?token=<this>
PUBSUB_TOKEN=

# Defaults to http://localhost:<PORT>. Set to the deployed URL in production.
PUBLIC_URL=
# Only in development, where Vite serves the dashboard on its own port.
WEB_URL=http://localhost:5173
